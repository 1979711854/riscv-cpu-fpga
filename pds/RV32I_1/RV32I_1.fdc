# 主时钟约束：27MHz（远程 FPGA 平台固定时钟，周期 37.037ns）
create_clock -name {clk} [get_ports {clk}] -period {37.037} -waveform {0.000 18.518} -add

define_attribute {p:done} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:done} {PAP_IO_LOC} {U16}
define_attribute {p:done} {PAP_IO_VCCIO} {3.3}
define_attribute {p:done} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:done} {PAP_IO_DRIVE} {8}
define_attribute {p:done} {PAP_IO_NONE} {TRUE}
define_attribute {p:done} {PAP_IO_SLEW} {SLOW}
define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {AB26}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_tx} {PAP_IO_SLEW} {SLOW}
define_attribute {p:clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk} {PAP_IO_LOC} {D18}
define_attribute {p:clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk} {PAP_IO_NONE} {TRUE}
define_attribute {p:resetn} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:resetn} {PAP_IO_LOC} {C22}
define_attribute {p:resetn} {PAP_IO_VCCIO} {3.3}
define_attribute {p:resetn} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:resetn} {PAP_IO_PULLUP} {TRUE}
