# ---- Claude Code 项目本地配置（含机器特定路径）----
.claude/

# ---- Windows ----
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- 通用编辑器 / 日志 ----
*.swp
*.swo
*.jou
*.log

# ---- Icarus Verilog / GTKWave 仿真生成物（本地产物，不入仓）----
*.vcd
*.vvp

# ---- 目录下的本地调试、日志与临时产物 ----
*.tmp
*.bak

# ---- Pango PDS（紫光同创）----
# PDS 工程统一放 pds/ 下；以下按相对路径忽略其生成物，
# 避免误伤仓库根 sim/（我们的 testbench 需要入库）。
# 具体目录名以创建 PDS 工程后的实际结构为准，届时再细化。
/pds/*/syn/
/pds/*/sim/
/pds/*/impl/
/pds/*/.pango/
/pds/*/run*/
/pds/**/*.wdb

# PDS 工程锁文件（每次打开 PDS 都会变，本机私有，不入库）
*.pds.lock

# ---- Vivado / AMD（若日后使用）----
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.bit
*.ltx
